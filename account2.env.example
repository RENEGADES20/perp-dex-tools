# GRVT Sub Account Configuration
# Copy this file to account2.env and fill in your credentials

# GRVT Trading Account ID (found in your GRVT account settings)
GRVT_TRADING_ACCOUNT_ID=your_sub_account_id_here

# GRVT Private Key (keep this secret!)
GRVT_PRIVATE_KEY=your_sub_private_key_here

# GRVT API Key (generated in GRVT API settings)
GRVT_API_KEY=your_sub_api_key_here

# GRVT Environment (prod, testnet, staging, or dev)
GRVT_ENVIRONMENT=prod
